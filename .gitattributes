# Large binaries: track with Git LFS if you push to GitHub (git lfs install first).
*.bit filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
*.pt  filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.pdf binary
*.png binary
# Text files keep LF endings so the Verilog and Tcl run unchanged on Linux and Windows
*.v    text eol=lf
*.vh   text eol=lf
*.mem  text eol=lf
*.tcl  text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.ps1  text eol=crlf
